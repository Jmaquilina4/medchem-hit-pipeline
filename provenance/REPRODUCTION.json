      "data_pull",
      "curate",
      "featurize",
      "qsar",
      "selectivity",
      "evaluate"
    ],
    "stages_note": "these six produce every published metric. `receptor` is excluded deliberately: it fetches a structure from the RCSB PDB, so including it would make this command require network. With MEDCHEM_FROZEN_SNAPSHOT set, the six stages contact no network -- note that WITHOUT it, data_pull queries ChEMBL and so needs network itself",
    "per_panel_commands": {
      "jak1": "MEDCHEM_FROZEN_SNAPSHOT=data/frozen_snapshots uv run medchem run -p discovery -c configs/jak1.yaml --force --workdir <fresh-empty-dir>/jak1 --stage data_pull --stage curate --stage featurize --stage qsar --stage selectivity --stage evaluate",
