      "brd4": "MEDCHEM_FROZEN_SNAPSHOT=data/frozen_snapshots uv run medchem run -p discovery -c configs/brd4.yaml --force --workdir <fresh-empty-dir>/brd4 --stage data_pull --stage curate --stage featurize --stage qsar --stage selectivity --stage evaluate",
      "brd4_sensitivity": "MEDCHEM_FROZEN_SNAPSHOT=data/frozen_snapshots uv run medchem run -p discovery -c configs/brd4_sensitivity.yaml --force --workdir <fresh-empty-dir>/brd4_sensitivity --stage data_pull --stage curate --stage featurize --stage qsar --stage selectivity --stage evaluate"
    },
    "compare_against": "provenance/<panel>/eval_report.json and selectivity_metrics.json",
    "why_force_and_workdir": "--force ignores the content-addressed cache and --workdir sends output to a fresh directory. Without both, the run resolves cached artifacts and demonstrates nothing about reproducibility: it would compare a file to itself"
